{
  "name": "minhash-sets",
  "version": "1.0.0",
  "type": "module",
  "description": "MinHash 集合相似度摘要与逐行碰撞解释后端（TypeScript + Node.js + SQLite，仅 API 与 CLI）",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "start": "node --no-warnings dist/server.js",
    "demo": "node --no-warnings dist/demo.js",
    "cli": "node --no-warnings dist/cli.js",
    "test": "node --test --import tsx --no-warnings \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
